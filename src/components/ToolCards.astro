---
// English cards show the description from the tool's source; Japanese cards show the
// description of the Japanese tool page, because no source has Japanese text to read.
import { getCollection } from "astro:content";
import type { Section } from "../../tools.config.ts";
import { factsIn, installLines, t, toolHref, type Lang } from "../lib/data.ts";

interface Props {
  lang: Lang;
  section: Section;
}
const { lang, section } = Astro.props;
const text = t(lang);

const jaDescriptions = new Map(
  (await getCollection("docs", (entry) => entry.id.startsWith("ja/tools/"))).map((entry) => [
    entry.id.slice("ja/tools/".length),
    entry.data.description,
  ]),
);

function cardDescription(slug: string, sourceDescription: string): string {
  if (lang === "en") return sourceDescription;
  const description = jaDescriptions.get(slug);
  if (!description) {
    throw new Error(`no description in src/content/docs/ja/tools/${slug}.mdx\ndo: add a description to its frontmatter`);
  }
  return description;
}
---

<ul class="tool-cards">
  {factsIn(section).map((fact) => (
    <li class="tool-card">
      <h3><a href={toolHref(fact.slug, lang)}>{fact.slug}</a> {fact.version !== null && <span class="tool-card__version">v{fact.version}</span>}</h3>
      <p>{cardDescription(fact.slug, fact.description)}</p>
      {installLines(fact).map((line) => <code class="tool-card__install">{line}</code>)}
      {fact.source !== "github" && fact.uses.length > 0 && <p class="tool-card__uses">{text.uses}: {fact.uses.join(", ")}</p>}
      <p class="tool-card__repo"><a href={fact.repo}>{text.repo}</a></p>
    </li>
  ))}
</ul>
