{
  "extends": "astro/tsconfigs/strict",
  "include": ["scripts", "src", "test", "*.ts", ".astro/types.d.ts"],
  "exclude": ["dist", "fixtures", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
